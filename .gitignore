# env files (can opt-in for committing if needed)
.env*
!.env.example

# credentials and local certificates
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
credentials.yaml
credentials.yml
service-account*.json
service_account*.json
secrets.*

# vercel
.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
