{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "wasp/*": [
        "./src/wasp/*"
      ],
      "react-router": [
        "./src/react-router-compat.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/app/layout.tsx",
    "src/app/page.tsx",
    "src/app/projects/**/*.tsx",
    "src/app/field-log/page.tsx",
    "src/app/reviewer-queue/page.tsx",
    "src/app/knowledge-base/page.tsx",
    "src/nirmaan/**/*.ts",
    "src/nirmaan/**/*.tsx",
    "src/landing-page/**/*.ts",
    "src/landing-page/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.wasp.ts",
    "src/payment/lemonSqueezy/**",
    "src/payment/polar/**",
    "src/payment/stripe/**",
    "src/server/scripts/**"
  ]
}
